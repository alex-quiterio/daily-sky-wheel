{
  "name": "daily-sky-wheel",
  "version": "0.1.0",
  "private": true,
  "description": "A daily astrology chart wheel in the browser: positions, houses, aspects, patterns and the day's sky events.",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "start": "npm run build && npx --yes serve@14.2.4 .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "astronomy-engine": "^2.1.19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "type": "module",
  "imports": {
    "#astro": "./src/astro/index.ts",
    "#astro/*": "./src/astro/*",
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/components/*",
    "#shell/*": "./src/shell/*",
    "#views/*": "./src/views/*"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
